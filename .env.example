# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Database (Prisma + MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/skillnest"

# ─── TEMPORARY TESTING ONLY - REMOVE BEFORE PRODUCTION ─────────────
# Set ENABLE_TEST_ACCOUNTS=true to show the test account switcher.
# This is ONLY for local/development testing. Never enable in production.
ENABLE_TEST_ACCOUNTS=false
TEST_STUDENT_EMAIL=
TEST_TEACHER_EMAIL=
TEST_ADMIN_EMAIL=
