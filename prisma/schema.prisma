generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   String                 @id @default(cuid())
  clerkUserId          String                 @unique
  email                String                 @unique
  firstName            String?
  lastName             String?
  role                 UserRole               @default(STUDENT)
  passwordHash         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  adminAuditLogs       AdminAuditLog[]
  submissions          AssignmentSubmission[]
  studentConversations Conversation[]         @relation("StudentConversations")
  enrollments          CourseEnrollment[]
  sentMessages         Message[]              @relation("SentMessages")
  notifications        Notification[]
  reviews              Review[]
  payments             Payment[]
  teacherProfile       TeacherProfile?

  @@map("users")
}

model Assignment {
  id          String                 @id @default(cuid())
  courseId    String
  title       String
  description String?                @db.Text
  dueDate     DateTime?
  maxMarks    Int?
  status      AssignmentStatus       @default(DRAFT)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions AssignmentSubmission[]
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([status])
  @@index([dueDate])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentUserId String
  content       String?          @db.Text
  submittedAt   DateTime?
  status        SubmissionStatus @default(NOT_SUBMITTED)
  marks         Int?
  feedback      String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentUser   User             @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentUserId])
  @@index([assignmentId])
  @@index([studentUserId])
  @@map("assignment_submissions")
}

model Subject {
  id              String           @id @default(cuid())
  name            String           @unique
  icon            String?
  createdAt       DateTime         @default(now())
  courses         Course[]
  teacherSubjects TeacherSubject[]

  @@map("subjects")
}

model TeacherProfile {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  status            TeacherProfileStatus   @default(PENDING_VERIFICATION)
  bio               String?                @db.Text
  phone             String?
  gender            String?
  location          String?
  profilePhotoUrl   String?                @db.MediumText
  teachingMode      TeachingMode           @default(BOTH)
  yearsOfExperience Int                    @default(0)
  hourlyRate        Float                  @default(0)
  currency          String                 @default("INR")
  pricingUnit       String                 @default("hour")
  teachingApproach  String?                @db.Text
  offlineLocation   String?
  availableFrom     String?
  availableTo       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  languages         String?
  reviewNote        String?                @db.Text
  teachingLevels    String?
  conversations     Conversation[]         @relation("TeacherConversations")
  courses           Course[]
  reviews           Review[]
  availability      TeacherAvailability[]
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualifications    TeacherQualification[]
  subjects          TeacherSubject[]

  @@index([status])
  @@index([location])
  @@index([teachingMode])
  @@index([yearsOfExperience])
  @@index([hourlyRate])
  @@map("teacher_profiles")
}

model TeacherSubject {
  id               String         @id @default(cuid())
  teacherProfileId String
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, subjectId])
  @@index([subjectId], map: "teacher_subjects_subjectId_fkey")
  @@map("teacher_subjects")
}

model TeacherAvailability {
  id               String         @id @default(cuid())
  teacherProfileId String
  day              DayOfWeek
  startTime        String
  endTime          String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, day])
  @@map("teacher_availability")
}

model TeacherQualification {
  id               String         @id @default(cuid())
  teacherProfileId String
  title            String
  institution      String?
  year             Int?
  field            String?
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId], map: "teacher_qualifications_teacherProfileId_fkey")
  @@map("teacher_qualifications")
}

model Course {
  id               String             @id @default(cuid())
  teacherProfileId String
  subjectId        String
  title            String
  description      String?            @db.Text
  teachingLevel    String?
  teachingMode     String?
  location         String?
  maxStudents      Int?
  status           CourseStatus       @default(DRAFT)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  assignments      Assignment[]
  classes          ClassSession[]
  enrollments      CourseEnrollment[]
  lessons          CourseLesson[]
  subject          Subject            @relation(fields: [subjectId], references: [id])
  teacherProfile   TeacherProfile     @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([subjectId])
  @@index([status])
  @@map("courses")
}

model CourseLesson {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  description String?  @db.Text
  content     String?  @db.LongText
  order       Int      @default(0)
  duration    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_lessons")
}

model CourseEnrollment {
  id              String           @id @default(cuid())
  courseId        String
  studentUserId   String
  status          EnrollmentStatus @default(PENDING)
  requestedAt     DateTime         @default(now())
  respondedAt     DateTime?
  rejectionReason String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentUser     User             @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@unique([courseId, studentUserId])
  @@index([courseId])
  @@index([studentUserId])
  @@index([status])
  @@map("course_enrollments")
}

model ClassSession {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  description String?      @db.Text
  startTime   DateTime
  endTime     DateTime
  mode        TeachingMode
  location    String?
  meetingUrl  String?
  status      ClassStatus  @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([startTime])
  @@index([status])
  @@map("class_sessions")
}

model Conversation {
  id               String         @id @default(cuid())
  studentUserId    String
  teacherProfileId String
  lastMessageAt    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentUser      User           @relation("StudentConversations", fields: [studentUserId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile @relation("TeacherConversations", fields: [teacherProfileId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@unique([studentUserId, teacherProfileId])
  @@index([studentUserId])
  @@index([teacherProfileId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderUserId   String
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User         @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Review {
  id               String         @id @default(cuid())
  teacherProfileId String
  studentUserId    String
  rating           Int
  comment          String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentUser      User           @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, studentUserId])
  @@index([teacherProfileId])
  @@index([studentUserId])
  @@map("reviews")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  reason      String?  @db.Text
  createdAt   DateTime @default(now())
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum TeachingMode {
  ONLINE
  OFFLINE
  BOTH
}

enum TeacherProfileStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  GRADED
}

enum EnrollmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  NEW_MESSAGE
  NEW_ENROLLMENT_REQUEST
  ENROLLMENT_ACCEPTED
  ENROLLMENT_REJECTED
  NEW_ASSIGNMENT
  ASSIGNMENT_GRADED
  CLASS_SCHEDULED
  CLASS_UPDATED
  CLASS_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  enrollmentId    String
  studentUserId   String
  amount          Float
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  description     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  enrollment      CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentUser     User          @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([studentUserId])
  @@index([status])
  @@map("payments")
}
